# SIP Server Configuration
# These environment variables are used by integration tests and development

# SIP Server Host
# Default: localhost
SIP_SERVER_HOST=localhost

# SIP Server Ports
# Default: 5060 (UDP/TCP), 5061 (TLS)
SIP_SERVER_PORT_UDP=5060
SIP_SERVER_PORT_TCP=5060
SIP_SERVER_PORT_TLS=5061

# Optional: Skip SIP integration tests
# Set to 'true' to skip SIP integration tests (useful for CI without Docker)
SKIP_SIP_INTEGRATION_TESTS=false

# Test User Credentials (for development/testing only)
# These match the test user configured in asterisk-config/pjsip.conf
SIP_TEST_USER=testuser
SIP_TEST_PASSWORD=testpass
