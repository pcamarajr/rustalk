{
  "name": "rustalk",
  "version": "0.1.0",
  "description": "Open-source white-label VoIP desktop application built with Rust and Tauri",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "docker-compose up -d && tauri dev",
    "tauri:dev:stop": "docker-compose down",
    "tauri:build": "tauri build",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "test": "echo \"Tests not yet implemented\" && exit 0",
    "lint": "svelte-check --tsconfig ./tsconfig.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@internationalized/date": "^3.10.0",
    "@lucide/svelte": "^0.544.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tauri-apps/cli": "^2",
    "autoprefixer": "^10.4.22",
    "bits-ui": "^2.14.3",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.553.0",
    "postcss": "^8.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
